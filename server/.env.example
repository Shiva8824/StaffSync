# Server Port (Render injects PORT automatically, typically 10000)
PORT=5000

# Server Host (0.0.0.0 binds to all network interfaces on cloud hosts)
HOST=0.0.0.0

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas URI)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/staffsync?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/staffsync

# JSON Web Token Secret & Expiration (Use a strong random 32+ character string in production)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin(s) for CORS (comma-separated for multiple origins)
# For unified deployment: can be omitted or set to your Render domain
# For split deployment: set to your frontend URL, e.g. https://your-frontend.onrender.com
CLIENT_URL=http://localhost:5173

# Runtime Environment (development or production)
NODE_ENV=development
